root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# Batch files in this repository are intentionally excluded from Git text
# normalization because some are kept in legacy Windows encodings.
[*.bat]
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
