{
  "schema_version": 1,
  "name": "default",
  "settings": {
    "filter_text_enabled": false,
    "kernel_size": 3,
    "mask_dilation_offset": 50,
    "use_custom_api_params": true,
    "translator": {
      "translator": "openai",
      "target_lang": "CHS",
      "thinking_level": "off",
      "user_api_base": null,
      "user_api_model": null,
      "aliyun_api_base": null,
      "keep_lang": "none",
      "enable_streaming": false,
      "no_text_lang_skip": false,
      "high_quality_prompt_path": "dict/prompt_example.yaml",
      "extract_glossary": true,
      "max_requests_per_minute": 0,
      "remove_trailing_period": true,
      "convert_to_traditional": false,
      "convert_to_simplified": false
    },
    "ocr": {
      "ocr_mode": "local",
      "ocr": "48px",
      "use_hybrid_ocr": false,
      "secondary_ocr": "mocr",
      "min_text_length": 0,
      "ignore_bubble": 0.0,
      "use_model_bubble_filter": false,
      "model_bubble_overlap_threshold": 0.1,
      "use_model_bubble_repair_intersection": true,
      "limit_mask_dilation_to_bubble_mask": true,
      "prob": 0.1,
      "merge_gamma": 0.8,
      "merge_sigma": 2.5,
      "merge_edge_ratio_threshold": 0.0,
      "merge_special_require_full_wrap": true,
      "ocr_vl_language_hint": "auto",
      "ocr_vl_custom_prompt": null,
      "ai_ocr_concurrency": 10,
      "ai_ocr_custom_prompt": null
    },
    "detector": {
      "detector": "default",
      "detection_size": 2048,
      "det_rearrange_min_effective_short_side": 341,
      "text_threshold": 0.5,
      "box_threshold": 0.5,
      "unclip_ratio": 2.5,
      "import_yolo_labels": false,
      "use_yolo_obb": false,
      "use_sfx_filter": false,
      "sfx_filter_include_bubble_text": false,
      "yolo_obb_conf": 0.4,
      "yolo_obb_overlap_threshold": 0.1,
      "min_box_area_ratio": 0.0
    },
    "inpainter": {
      "inpainter": "lama_mpe",
      "inpainting_size": 1024,
      "inpainting_precision": "fp32",
      "force_use_torch_inpainting": false,
      "solid_fill_pure_bubbles": true,
      "per_block_inpainting": false
    },
    "render": {
      "renderer": "default",
      "alignment": "auto",
      "disable_font_border": false,
      "disable_auto_wrap": false,
      "font_size_offset": 0,
      "font_size_minimum": 0,
      "direction": "auto",
      "uppercase": false,
      "lowercase": false,
      "font_family": "STFangsong",
      "disable_system_fonts": false,
      "no_hyphenation": false,
      "bubble_layout_english": false,
      "font_color": null,
      "line_spacing": 1.0,
      "letter_spacing": 1.0,
      "font_size": null,
      "rtl": true,
      "layout_mode": "balloon_fill",
      "balloon_fill_mask_layout": false,
      "max_font_size": 0,
      "font_scale_ratio": 1.0,
      "center_text_in_bubble": true,
      "optimize_line_breaks": false,
      "semantic_linebreak": false,
      "remove_linebreak_punctuation": false,
      "check_br_and_retry": false,
      "strict_smart_scaling": false,
      "stroke_width": 0.07,
      "enable_template_alignment": false,
      "paste_mask_dilation_pixels": 10,
      "ai_renderer_concurrency": 1
    },
    "upscale": {
      "upscaler": "mangajanai",
      "upscale_ratio": null,
      "realcugan_model": null,
      "tile_size": 400,
      "revert_upscaling": false
    },
    "colorizer": {
      "colorization_size": 2048,
      "denoise_sigma": 30,
      "colorizer": "none",
      "ai_colorizer_history_pages": 0
    },
    "cli": {
      "verbose": true,
      "attempts": 3,
      "ignore_errors": false,
      "use_gpu": true,
      "disable_onnx_gpu": false,
      "context_size": 3,
      "format": "jpg",
      "overwrite": true,
      "skip_no_text": true,
      "save_text": false,
      "export_from_local_json": true,
      "load_text": false,
      "translate_json_only": false,
      "template": false,
      "save_quality": 100,
      "batch_size": 1,
      "batch_concurrent": true,
      "max_workers": 1,
      "generate_and_export": false,
      "colorize_only": false,
      "upscale_only": false,
      "inpaint_only": false,
      "save_to_source_dir": false,
      "generate_long_image": false,
      "generate_html": false,
      "html_view_mode": "scroll",
      "export_editable_psd": false,
      "psd_script_only": false,
      "replace_translation": false
    },
    "app": {
      "unload_models_after_translation": false
    }
  }
}
